--- a/send_transient_unix.go	1970-01-01 03:00:00.000000000 +0300
+++ b/send_transient_unix.go	2026-10-02 13:14:42.780818400 +0300
@@ -0,0 +1,49 @@
+//go:build linux
+
+package quic
+
+import (
+	"errors"
+	"time"
+
+	"golang.org/x/sys/unix"
+)
+
+// Очередь сокета переполнена — это «повтори позже», а не отказ пути.
+const (
+	transientTries = 12
+	transientPause = 250 * time.Microsecond
+)
+
+func isBusySendErr(err error) bool {
+	return errors.Is(err, unix.ENOBUFS) || errors.Is(err, unix.EAGAIN)
+}
+
+// Путь пропал: телефон ушёл с Wi-Fi на соту, интерфейс исчез, маршрута нет.
+// Upstream роняет по такой ошибке всю сессию (sendQueue.Run), и туннель умирал
+// в момент смены сети — раньше, чем система успевала сообщить о новой сети и
+// раньше, чем QUIC успевал переехать миграцией.
+//
+// Повторять здесь нечего — маршрута нет, — но и рвать сессию нельзя: пакет
+// теряется, соединение живёт, миграция переносит его на новый путь.
+func isPathGoneErr(err error) bool {
+	return errors.Is(err, unix.ENETUNREACH) || errors.Is(err, unix.EHOSTUNREACH) ||
+		errors.Is(err, unix.ENETDOWN) || errors.Is(err, unix.EADDRNOTAVAIL) ||
+		errors.Is(err, unix.EPERM)
+}
+
+func isTransientSendErr(err error) bool { return isBusySendErr(err) || isPathGoneErr(err) }
+
+func retrySend(send func() error, err error) error {
+	if isPathGoneErr(err) {
+		return nil
+	}
+	for i := 0; i < transientTries && isBusySendErr(err); i++ {
+		time.Sleep(transientPause)
+		err = send()
+	}
+	if isTransientSendErr(err) {
+		return nil
+	}
+	return err
+}

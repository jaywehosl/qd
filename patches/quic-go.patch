+)
+
+const (
+	qdUDPSendMsgSize = 2
+	qdUDPCoalesced   = 3
+	qdCoalescedMax   = 65527
+)
+
+type usoConn struct {
+	*basicConn
+	raw syscall.RawConn
+	v6  bool
+	off atomic.Bool
+	ran atomic.Bool
+
+	conn    OOBCapablePacketConn
+	scratch []byte
+	oob     []byte
+	pending []receivedPacket
+	next    int
+}
+
+func qdWrapUSO(c OOBCapablePacketConn, supportsDF bool) rawConn {
+	b := &basicConn{PacketConn: c, supportsDF: supportsDF}
+	if os.Getenv("QD_USO") == "off" {
+		return b
+	}
+	raw, err := c.SyscallConn()
+	if err != nil {
+		return b
+	}
+	var serr error
+	if err := raw.Control(func(fd uintptr) {
+		_, serr = windows.GetsockoptInt(windows.Handle(fd), windows.IPPROTO_UDP, qdUDPSendMsgSize)
+	}); err != nil || serr != nil {
+		return b
+	}
+	local, _ := c.LocalAddr().(*net.UDPAddr)
+	u := &usoConn{basicConn: b, raw: raw, v6: local == nil || local.IP.To4() == nil}
+	if err := raw.Control(func(fd uintptr) {

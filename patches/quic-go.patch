+
+func retrySend(_ func() error, err error) error { return err }
diff -ruN '--exclude=.git' qg-orig/send_transient_windows.go C:/Users/jaywehosl/Desktop/quic-diver/third_party/quic-go/send_transient_windows.go
--- a/send_transient_windows.go	1970-01-01 03:00:00.000000000 +0300
+++ b/send_transient_windows.go	2026-09-03 18:07:17.684880700 +0300
@@ -0,0 +1,38 @@
+//go:build windows
+
+package quic
+
+import (
+	"errors"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+// Ядро Windows отвечает WSAENOBUFS, когда очередь сокета переполнена: на отдаче
+// в сотни мегабит это «повтори позже», а не отказ пути. Upstream роняет по любой
+// ошибке записи всю сессию (sendQueue.Run), и туннель умирал на середине
+// аплоада — с ним и все живые соединения приложений.
+//
+// Ждём столько, сколько нужно ядру, чтобы разгрести очередь, и повторяем. Если
+// не помогло за transientTries — пакет теряется, но соединение остаётся: потерю
+// QUIC закроет своим ретрансмитом.
+const (
+	transientTries = 12
+	transientPause = 250 * time.Microsecond
+)
+
+func isTransientSendErr(err error) bool {
+	return errors.Is(err, windows.WSAENOBUFS) || errors.Is(err, windows.WSAEWOULDBLOCK)
+}
+
+func retrySend(send func() error, err error) error {
+	for i := 0; i < transientTries && isTransientSendErr(err); i++ {
+		time.Sleep(transientPause)
+		err = send()
+	}
+	if isTransientSendErr(err) {
+		return nil // сдались на этом пакете, но сессию не рвём
+	}
+	return err
+}

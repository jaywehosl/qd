 }
+
+const qdAckThreshold = 9
+
+func qdOn(name string) bool { return os.Getenv(name) != "off" }
+
+func qdMinAckDelay() *time.Duration {
+	if !qdOn("QD_ACKFREQ") {
+		return nil
+	}
+	d := protocol.QDMinAckDelay
+	return &d
+}
+
+func (c *Conn) qdTuneAckFrequency() {
+	if !c.handshakeConfirmed || c.peerParams == nil || c.peerParams.MinAckDelay == nil || !qdOn("QD_ACKFREQ") {
+		return
+	}
+	want := min(max(c.rttStats.SmoothedRTT()/4, *c.peerParams.MinAckDelay), c.peerParams.MaxAckDelay)
+	if last := c.qdFreqDelay; last != 0 && want*4 > last*3 && want*4 < last*5 {
+		return
+	}
+	c.qdFreqDelay = want
+	c.framer.QueueControlFrame(&wire.AckFrequencyFrame{
+		SequenceNumber:        c.qdFreqSeq,
+		AckElicitingThreshold: qdAckThreshold,
+		RequestMaxAckDelay:    want,
+		ReorderingThreshold:   1,
+	})
+	c.qdFreqSeq++
+}

+		profile:                      ProfileStandard,
+		highGain:                     defaultHighGain,
+		highCwndGain:                 derivedHighCWNDGain,
+		drainGain:                    1.0 / defaultHighGain,
+		pacingGain:                   1.0,
+		congestionWindowGain:         1.0,

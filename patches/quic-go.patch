+++ b/send_transient_windows.go	2026-10-02 13:14:42.778797500 +0300
@@ -0,0 +1,38 @@
+//go:build windows
+
+package quic
+
+import (
+	"errors"
+	"time"
+
+	"golang.org/x/sys/windows"
+)
+
+// Ядро Windows отвечает WSAENOBUFS, когда очередь сокета переполнена: на отдаче
+// в сотни мегабит это «повтори позже», а не отказ пути. Upstream роняет по любой
+// ошибке записи всю сессию (sendQueue.Run), и туннель умирал на середине
+// аплоада — с ним и все живые соединения приложений.
+//
+// Ждём столько, сколько нужно ядру, чтобы разгрести очередь, и повторяем. Если
+// не помогло за transientTries — пакет теряется, но соединение остаётся: потерю
+// QUIC закроет своим ретрансмитом.
+const (
+	transientTries = 12
+	transientPause = 250 * time.Microsecond
+)
+
+func isTransientSendErr(err error) bool {
+	return errors.Is(err, windows.WSAENOBUFS) || errors.Is(err, windows.WSAEWOULDBLOCK)
+}
+
+func retrySend(send func() error, err error) error {
+	for i := 0; i < transientTries && isTransientSendErr(err); i++ {
+		time.Sleep(transientPause)
+		err = send()
+	}
+	if isTransientSendErr(err) {
+		return nil // сдались на этом пакете, но сессию не рвём
+	}
+	return err
+}
--- a/sys_conn_uso_windows.go	1970-01-01 03:00:00.000000000 +0300
+++ b/sys_conn_uso_windows.go	2026-10-02 13:14:42.792868600 +0300
@@ -0,0 +1,126 @@
+//go:build windows
+
+package quic
+
+import (
+	"errors"
+	"net"
+	"os"
+	"sync/atomic"
+	"syscall"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+
+	"github.com/quic-go/quic-go/internal/protocol"
+)
+
+const qdUDPSendMsgSize = 2
+
+type usoConn struct {
+	*basicConn
+	raw syscall.RawConn
+	v6  bool
+	off atomic.Bool
+}
+
+func qdWrapUSO(c OOBCapablePacketConn, supportsDF bool) rawConn {
+	b := &basicConn{PacketConn: c, supportsDF: supportsDF}
+	if os.Getenv("QD_USO") == "off" {
+		return b
+	}
+	raw, err := c.SyscallConn()
+	if err != nil {
+		return b
+	}
+	var serr error
+	if err := raw.Control(func(fd uintptr) {
+		_, serr = windows.GetsockoptInt(windows.Handle(fd), windows.IPPROTO_UDP, qdUDPSendMsgSize)
+	}); err != nil || serr != nil {
+		return b
+	}
+	local, _ := c.LocalAddr().(*net.UDPAddr)
+	return &usoConn{basicConn: b, raw: raw, v6: local == nil || local.IP.To4() == nil}
+}
+
+func (c *usoConn) capabilities() connCapabilities {
+	return connCapabilities{DF: c.supportsDF, GSO: !c.off.Load()}
+}
+
+func (c *usoConn) WritePacket(b []byte, addr net.Addr, _ []byte, gsoSize uint16, _ protocol.ECN) (int, error) {
+	if gsoSize == 0 || len(b) <= int(gsoSize) {
+		return c.WriteTo(b, addr)
+	}
+	if !c.off.Load() {
+		n, err := c.sendSegmented(b, addr, gsoSize)
+		if err == nil || isTransientSendErr(err) {
+			return n, err
+		}
+	}
+	total := len(b)
+	for len(b) > 0 {
+		seg := b[:min(len(b), int(gsoSize))]
+		if _, err := c.WriteTo(seg, addr); err != nil {
+			return 0, err
+		}
+		b = b[len(seg):]
+	}
+	c.off.Store(true)
+	return total, nil
+}
+
+func (c *usoConn) sendSegmented(b []byte, addr net.Addr, gsoSize uint16) (int, error) {
+	ua, ok := addr.(*net.UDPAddr)
+	if !ok {
+		return 0, errors.New("uso: not a UDP address")
+	}
+	ap := ua.AddrPort()
+	var sa4 windows.RawSockaddrInet4
+	var sa6 windows.RawSockaddrInet6
+	var name unsafe.Pointer
+	var namelen int32
+	if c.v6 {
+		sa6.Family = windows.AF_INET6
+		port := (*[2]byte)(unsafe.Pointer(&sa6.Port))
+		port[0], port[1] = byte(ap.Port()>>8), byte(ap.Port())
+		sa6.Addr = ap.Addr().As16()
+		name, namelen = unsafe.Pointer(&sa6), int32(unsafe.Sizeof(sa6))
+	} else {
+		sa4.Family = windows.AF_INET
+		port := (*[2]byte)(unsafe.Pointer(&sa4.Port))
+		port[0], port[1] = byte(ap.Port()>>8), byte(ap.Port())
+		sa4.Addr = ap.Addr().Unmap().As4()
+		name, namelen = unsafe.Pointer(&sa4), int32(unsafe.Sizeof(sa4))
+	}
+
+	const word = unsafe.Sizeof(uintptr(0))
+	const head = (word + 8 + word - 1) &^ (word - 1)
+	const space = head + (4+word-1)&^(word-1)
+	var ctl [4]uint64
+	raw := unsafe.Slice((*byte)(unsafe.Pointer(&ctl[0])), space)
+	*(*uintptr)(unsafe.Pointer(&raw[0])) = head + 4
+	*(*int32)(unsafe.Pointer(&raw[word])) = windows.IPPROTO_UDP
+	*(*int32)(unsafe.Pointer(&raw[word+4])) = qdUDPSendMsgSize
+	*(*uint32)(unsafe.Pointer(&raw[head])) = uint32(gsoSize)
+
+	buf := windows.WSABuf{Len: uint32(len(b)), Buf: &b[0]}
+	msg := windows.WSAMsg{
+		Name:        (*syscall.RawSockaddrAny)(name),
+		Namelen:     namelen,
+		Buffers:     &buf,
+		BufferCount: 1,
+		Control:     windows.WSABuf{Len: uint32(space), Buf: &raw[0]},
+	}
+	var sent uint32
+	var serr error
+	if err := c.raw.Write(func(fd uintptr) bool {
+		serr = windows.WSASendMsg(windows.Handle(fd), &msg, 0, &sent, nil, nil)
+		return true
+	}); err != nil {
+		return 0, err
+	}
+	if serr != nil {
+		return 0, serr
+	}
+	return int(sent), nil
+}

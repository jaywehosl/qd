+func (c *Conn) qdTuneAckFrequency() {
+	if !c.handshakeConfirmed || c.peerParams == nil || c.peerParams.MinAckDelay == nil || !qdOn("QD_ACKFREQ") {
+		return
+	}
+	want := min(max(c.rttStats.SmoothedRTT()/4, *c.peerParams.MinAckDelay), c.peerParams.MaxAckDelay)
+	if c.qdFreqWant == 0 {
+		c.qdFreqWant = qdAckThreshold
+	}
+	now := monotime.Now()
+	if took := now.Sub(c.qdFreqAt); took >= qdAckWindow {
+		sent := c.connStats.BytesSent.Load()
+		if !c.qdFreqAt.IsZero() {
+			perMs := float64(sent-c.qdFreqBytes) / qdAckPacket / float64(took.Milliseconds())
+			c.qdFreqWant = uint64(min(max(perMs, qdAckThreshold), qdAckThresholdMax))
+		}
+		c.qdFreqBytes, c.qdFreqAt = sent, now
+	}
+	every := c.qdFreqWant
+	steady := c.qdFreqEvery != 0 && every < c.qdFreqEvery*2 && every*2 > c.qdFreqEvery
+	if last := c.qdFreqDelay; steady && last != 0 && want*4 > last*3 && want*4 < last*5 {
+		return

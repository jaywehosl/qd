+type qdResetRunner interface {
+	AddResetToken(protocol.StatelessResetToken, packetHandler)
+	RemoveResetToken(protocol.StatelessResetToken)
+}
+
+func (c *Conn) qdAddResetToken(token protocol.StatelessResetToken) {
+	c.qdResetMu.Lock()
+	defer c.qdResetMu.Unlock()
+	if c.qdResetTokens == nil {
+		c.qdResetTokens = map[protocol.StatelessResetToken]struct{}{}
+	}
+	c.qdResetTokens[token] = struct{}{}
+	for _, runner := range c.qdRunners {
+		runner.AddResetToken(token, c)
+	}
+}
+
+func (c *Conn) qdRemoveResetToken(token protocol.StatelessResetToken) {
+	c.qdResetMu.Lock()
+	defer c.qdResetMu.Unlock()
+	delete(c.qdResetTokens, token)
+	for _, runner := range c.qdRunners {
+		runner.RemoveResetToken(token)
+	}
+}
+
+func (c *Conn) qdAdoptRunner(runner qdResetRunner) {
+	c.qdResetMu.Lock()
+	defer c.qdResetMu.Unlock()
+	c.qdRunners = append(c.qdRunners, runner)
+	for token := range c.qdResetTokens {
+		runner.AddResetToken(token, c)
+	}
+}
+

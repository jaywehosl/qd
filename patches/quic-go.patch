+func scaleByteWindowForDatagramSize(window, oldMaxDatagramSize, newMaxDatagramSize protocol.ByteCount) protocol.ByteCount {
+	if oldMaxDatagramSize == newMaxDatagramSize {
+		return window
+	}
+	return protocol.ByteCount(uint64(window) * uint64(newMaxDatagramSize) / uint64(oldMaxDatagramSize))

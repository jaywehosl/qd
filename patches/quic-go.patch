--- a/internal/congestion/brutal_sender.go	1970-01-01 03:00:00.000000000 +0300
+++ b/internal/congestion/brutal_sender.go	2026-09-03 00:52:25.985199800 +0300
@@ -0,0 +1,92 @@
+package congestion
+
+import (
+	"time"
+
+	"github.com/quic-go/quic-go/internal/monotime"
+	"github.com/quic-go/quic-go/internal/protocol"
+	"github.com/quic-go/quic-go/internal/utils"
+)
+
+// brutalSender — congestion control, который шлёт с ЗАДАННОЙ полосой и не считает
+// потери сигналом перегрузки (идея из Hysteria).
+//
+// Зачем (измерено на живом плече 850 км, RTT 17-25 мс):
+//
+//	сырой UDP (потери игнорирует)      — 756 Мбит
+//	QUIC с loss-based CC (Reno/Cubic)  — 458-561, плавает вслед за потерями
+//	потери сети                        — 0.016-0.27%, RTT при этом здоров
+//
+// То есть канал свободен (очередей нет, RTT не растёт), но редкие случайные
+// потери заставляют loss-based алгоритм резать окно и терять четверть полосы.
+// Brutal их игнорирует и держит заданный темп.
+//
+// Цена: полоса задаётся вручную. Задрать выше реальной — получить очереди и рост
+// RTT (bufferbloat), поэтому ставить надо НИЖЕ измеренной пропускной способности.
+type brutalSender struct {
+	clock           Clock
+	rttStats        *utils.RTTStats
+	bps             Bandwidth
+	maxDatagramSize protocol.ByteCount
+	pacer           *pacer
+}
+
+// NewBrutalSender создаёт sender с фиксированной полосой bps.
+func NewBrutalSender(clock Clock, rttStats *utils.RTTStats, bps Bandwidth, initialMaxDatagramSize protocol.ByteCount) SendAlgorithmWithDebugInfos {
+	b := &brutalSender{
+		clock:           clock,
+		rttStats:        rttStats,
+		bps:             bps,
+		maxDatagramSize: initialMaxDatagramSize,
+	}
+	b.pacer = newPacer(func() Bandwidth { return b.bps })
+	return b
+}
+
+func (b *brutalSender) TimeUntilSend(_ protocol.ByteCount) monotime.Time {
+	return b.pacer.TimeUntilSend()
+}
+
+func (b *brutalSender) HasPacingBudget(now monotime.Time) bool {
+	return b.pacer.Budget(now) >= b.maxDatagramSize
+}
+
+func (b *brutalSender) OnPacketSent(sentTime monotime.Time, _ protocol.ByteCount, _ protocol.PacketNumber, bytes protocol.ByteCount, _ bool) {
+	b.pacer.SentPacket(sentTime, bytes)
+}
+
+func (b *brutalSender) CanSend(bytesInFlight protocol.ByteCount) bool {
+	return bytesInFlight < b.GetCongestionWindow()
+}
+
+// GetCongestionWindow — окно по модели полосы: BDP с двойным запасом, чтобы
+// пейсер не простаивал в ожидании ACK.
+func (b *brutalSender) GetCongestionWindow() protocol.ByteCount {
+	rtt := b.rttStats.SmoothedRTT()
+	if rtt <= 0 {
+		rtt = 100 * time.Millisecond // до первых замеров
+	}
+	cwnd := protocol.ByteCount(uint64(b.bps) * uint64(rtt) / uint64(time.Second) / 8 * 2)
+	if min := 4 * b.maxDatagramSize; cwnd < min {
+		cwnd = min
+	}
+	return cwnd
+}
+
+// Потери и таймауты игнорируем намеренно — в этом весь смысл алгоритма.
+func (b *brutalSender) MaybeExitSlowStart()                                                     {}
+func (b *brutalSender) OnPacketAcked(protocol.PacketNumber, protocol.ByteCount, protocol.ByteCount, monotime.Time) {}
+func (b *brutalSender) OnCongestionEvent(protocol.PacketNumber, protocol.ByteCount, protocol.ByteCount) {}
+func (b *brutalSender) OnRetransmissionTimeout(bool)                                            {}
+
+func (b *brutalSender) SetMaxDatagramSize(s protocol.ByteCount) {
+	b.maxDatagramSize = s
+	b.pacer.SetMaxDatagramSize(s)
+}
+
+// --- SendAlgorithmWithDebugInfos ---
+
+func (b *brutalSender) InSlowStart() bool                   { return false }
+func (b *brutalSender) InRecovery() bool                    { return false }
+func (b *brutalSender) GetSlowStartThreshold() protocol.ByteCount { return 0 }
+func (b *brutalSender) BandwidthEstimate() Bandwidth        { return b.bps }
